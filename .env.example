# Primary LLM (Gemini free tier, Flash-class model)
GEMINI_API_KEY=
# Run scripts/check_models.py to see what your key can use.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Fallback LLM (DeepSeek, OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# SQLite locally; Supabase Postgres in production, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./dental.db

# Optional: Slack incoming webhook for staff alerts (alerts are always stored in the DB first)
SLACK_WEBHOOK_URL=

# Shared secret for the /staff page and staff API (required in any shared deployment)
STAFF_TOKEN=

OFFICE_TZ=America/Los_Angeles

# Client-side cap on LLM requests per minute (evals use 8 for the free tier). 0 = off.
LLM_MAX_RPM=0
