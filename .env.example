# Primary LLM (Gemini free tier, Flash-class model)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback LLM (DeepSeek, OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# SQLite locally; Supabase Postgres in production, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./dental.db

# Optional: Slack incoming webhook for staff alerts (alerts are always stored in the DB first)
SLACK_WEBHOOK_URL=

OFFICE_TZ=America/Los_Angeles
