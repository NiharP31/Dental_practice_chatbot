# LLM providers, tried in this order. Any provider without a key is skipped, so the app runs on a
# free GEMINI_API_KEY alone. LLM_CHAIN=gemini skips Claude even when its key is set.
LLM_CHAIN=claude,gemini

# Primary: Claude (paid, about $0.01 per conversation on Haiku)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Fallback: Gemini free tier. Run scripts/check_models.py to see what your key can use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Cost protection for a public URL
DAILY_LLM_BUDGET_USD=3     # billed providers (Claude) are skipped for the rest of the day past this
RATE_LIMIT_PER_MIN=20      # POST requests per client IP per minute
LLM_MAX_RPM=0              # client-side cap on LLM calls per minute; evals use 8 on the free Gemini tier

# SQLite locally; Supabase Postgres in production, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./dental.db

# Optional: Slack incoming webhook for staff alerts (alerts are always stored in the DB first)
SLACK_WEBHOOK_URL=

# Shared secret for the /staff page and staff API (required in any shared deployment)
STAFF_TOKEN=

OFFICE_TZ=America/Los_Angeles
